{
  "name": "Nightingale",
  "version": "1.4.1",
  "private": true,
  "description": "Nightingale — Karaoke from your music library.",
  "type": "module",
  "scripts": {
    "audit:rust": "cd .. && cargo deny check",
    "build": "tsc && vite build",
    "check": "pnpm quality",
    "dev": "vite",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "format:rust": "cd .. && cargo fmt --all",
    "format:rust:check": "cd .. && cargo fmt --all --check",
    "format:staged": "oxfmt --no-error-on-unmatched-pattern",
    "icons": "tauri icon src/assets/images/logo_square.png",
    "lint": "pnpm lint:code && pnpm lint:css",
    "lint:code": "oxlint",
    "lint:code:fix": "oxlint --fix",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:css:fix": "stylelint \"src/**/*.css\" --fix",
    "lint:fix": "pnpm lint:code:fix && pnpm lint:css:fix",
    "lint:rust": "cd .. && cargo clippy --workspace --all-targets --all-features --locked -- -D warnings",
    "postinstall": "pnpm rules:generate",
    "prepare": "cd .. && husky client/.husky",
    "preview": "vite preview",
    "quality": "pnpm quality:web && pnpm quality:rust && pnpm rules:check",
    "quality:rust": "pnpm format:rust:check && cd .. && cargo check --workspace --all-targets --all-features --locked && cd client && pnpm lint:rust",
    "quality:web": "pnpm format:check && pnpm lint && pnpm typecheck",
    "rules:check": "cd .. && node client/node_modules/rulesync/dist/cli/index.js doctor --strict && node client/node_modules/rulesync/dist/cli/index.js generate --dry-run --silent",
    "rules:generate": "cd .. && node client/node_modules/rulesync/dist/cli/index.js generate",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@react-three/fiber": "^9.5.0",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/react-query": "^4.43.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "~2.6.0",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-os": "^2.3.2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "input-otp": "^1.4.2",
    "jotai": "^2.18.1",
    "lucide-react": "^0.577.0",
    "next-themes": "^0.4.6",
    "pitchy": "^4.1.0",
    "pretty-bytes": "^7.1.0",
    "radix-ui": "^1.4.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "react-router": "^7.13.1",
    "shadcn": "^4.0.8",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2",
    "three": "^0.183.2",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/node": "^25.5.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/three": "^0.183.1",
    "@vitejs/plugin-react": "^6.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": "^7.0.2001",
    "rulesync": "^16.17.0",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "~5.8.3",
    "vite": "^8.0.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": "pnpm run lint:code",
    "*.css": "pnpm exec stylelint",
    "*": "pnpm run format:staged"
  },
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@11.2.2"
}
