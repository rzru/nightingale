{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nightingale",
  "version": "1.2.0",
  "identifier": "com.rzru.client",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "create": false,
        "title": "Nightingale",
        "width": 1280,
        "height": 720,
        "decorations": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:* https:; img-src 'self' asset: http://asset.localhost https:; media-src 'self' http://127.0.0.1:* https:; style-src 'self' 'unsafe-inline'",
      "assetProtocol": {
        "enable": true,
        "scope": ["$HOME/.nightingale/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "shortDescription": "Nightingale — Karaoke from your music library.",
    "longDescription": "Nightingale — Karaoke from your music library. Synchronized lyrics, immersive backgrounds, and fullscreen playback for your own tracks. Licensed under the GNU General Public License v3.",
    "category": "Music",
    "copyright": "Copyright © 2026 rzru",
    "publisher": "rzru",
    "license": "GPL-3.0",
    "licenseFile": "../../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkwODM4MDM1QjIzNTVGRQpSV1QrVlNOYkF6Z0lDYjRmZzlRR3VWVHFSQllmOVVWMnpxTUlrYlNrTlhXVEQrZjNYY0ttNWIvSgo=",
      "endpoints": ["https://github.com/rzru/nightingale/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    },
    "deep-link": {
      "desktop": {
        "schemes": ["nightingale"]
      }
    }
  }
}
