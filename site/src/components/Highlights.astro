---
const flagship = [
  {
    title: "Nightingale in your language",
    description:
      "Switch the interface between English, German, and Simplified Chinese — or follow your system. The choice follows your settings into the playback window and self-hosted sessions.",
  },
  {
    title: "The pitch guide takes the stage",
    description:
      "Turn the whole screen into a scrolling pitch graph with octave lanes, live target notes, audio-reactive visuals, and color-coded trails for every singer.",
  },
  {
    title: "Your phone is the remote",
    description:
      "Scan the QR code in the sidebar to queue songs, skip, seek, and adjust playback settings from any phone on the same network.",
  },
];

const alsoNew = [
  {
    title: "Songs in one file",
    description:
      "Play and export `.nge` bundles that carry stems, lyrics, cover, and video together, with no unpacking or re-analysis.",
  },
  {
    title: "Five stars, then the next song",
    description:
      "Watch your score fill five stars as you sing, then let Auto-continue start the next queued song after the results.",
  },
  {
    title: "Jump anywhere in the song",
    description:
      "Scrub the timeline or jump one second or one lyric line, and re-sing a line without keeping the score you already earned past it.",
  },
];
---

<section id="highlights">
  <div class="container highlights-layout">
    <div class="highlights-lead">
      <h2 class="section-title">What’s new in v1.4.1</h2>
      <a href="/docs/" class="docs-link">See full docs <span aria-hidden="true">↗</span></a>
    </div>
    <div class="highlight-list">
      {flagship.map((item) => (
        <article class="highlight">
          <h3>{item.title}</h3>
          <p>{item.description}</p>
        </article>
      ))}
      <div class="also-new">
        {alsoNew.map((item) => (
          <article>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  #highlights {
    border-top: 1px solid var(--border);
  }

  .highlights-layout {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: clamp(40px, 8vw, 120px);
  }

  .highlights-lead .docs-link {
    display: inline-block;
    margin-block-start: 28px;
  }

  .highlight {
    display: grid;
    grid-template-columns: minmax(150px, 0.7fr) 1fr;
    gap: 24px;
    padding-block: 26px;
    border-top: 1px solid var(--border);
  }

  .highlight h3 {
    font-size: 1.3rem;
  }

  .highlight p,
  .also-new p {
    color: var(--text-secondary);
    font-size: 0.94rem;
  }

  .also-new {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 25px;
    margin-block-start: 25px;
    padding-block-start: 26px;
    border-top: 1px solid var(--border);
  }

  .also-new h3 {
    margin-block-end: 10px;
    font-size: 1rem;
  }

  @media (max-width: 850px) {
    .highlights-layout {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .highlight,
    .also-new {
      grid-template-columns: 1fr;
    }

    .highlight {
      gap: 12px;
    }

    .also-new {
      gap: 24px;
    }
  }
</style>
